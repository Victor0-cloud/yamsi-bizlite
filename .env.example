# YAMSI BizLite example environment. Placeholders ONLY -- never put real
# tokens, keys, phone numbers, secrets, or database URLs in this file.
# Copy to .env for local work (ignored by git) or enter each value in the
# private Render environment panel for production. See
# WHATSAPP_DEPLOYMENT.md for the activation runbook.

# --- Required: WhatsApp inbound (Meta webhook verification) ---
WHATSAPP_VERIFY_TOKEN=<WHATSAPP_VERIFY_TOKEN>
WHATSAPP_APP_SECRET=<WHATSAPP_APP_SECRET>
WHATSAPP_WEBHOOK_BASE_URL=https://<RENDER_SERVICE>.onrender.com

# --- Required: WhatsApp outbound (Cloud API) ---
WHATSAPP_ACCESS_TOKEN=<WHATSAPP_ACCESS_TOKEN>
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Required: Supabase (service role, server only) ---
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SECRET_KEY=<SERVICE_ROLE_KEY>

# --- Required: owner key protecting all /internal/* routes ---
YAMSI_API_KEY=<OWNER_KEY>

# --- Optional: deployment mode (default when unset is production) ---
# WHATSAPP_ENV=production
# WHATSAPP_ENV=local
# WHATSAPP_ENV=test

# --- Optional: outbound HTTP read/write timeout, seconds (default 10) ---
# OUTBOUND_HTTP_TIMEOUT_SECONDS=10

# --- Optional: Telegram backup channel (see TELEGRAM_DEPLOYMENT.md) ---
# TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
# TELEGRAM_WEBHOOK_SECRET=<TELEGRAM_WEBHOOK_SECRET>
